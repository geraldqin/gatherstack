  "optionsAboutProductName": {
    "message": "智能剪報（GatherStack）",
    "description": "About: product name line"
  },
  "optionsAboutCoreHeading": {
    "message": "核心用法",
    "description": "About section: core usage"
  },
  "optionsAboutDescription": {
    "message": "使用 AI 解析各種網頁，儲存到本地，方便後續的彙總處理。",
    "description": "About: core usage lead"
  },
  "optionsAboutWhatExtra": {
    "message": "適用於：跨網頁資訊採集、處理。",
    "description": "About: typical uses"
  },
  "optionsAboutInspirationHeading": {
    "message": "靈感來源",
    "description": "About section: inspiration"
  },
  "optionsAboutInspirationP1": {
    "message": "我在租房子的過程中，需要手動記錄房子位置、租金等各種資訊，然後彙總起來對比。",
    "description": "About inspiration paragraph 1"
  },
  "optionsAboutInspirationP2": {
    "message": "現在有了大模型，我希望能簡化我的這個操作。",
    "description": "About inspiration paragraph 2"
  },
  "optionsAboutInspirationP3": {
    "message": "我的規劃是，瀏覽租房網站，看到還可以的租房資訊，就用大模型按照我事先設定好的抽取規則（我這裡叫它 Skill），抽取我關注的資訊，儲存到瀏覽器。",
    "description": "About inspiration paragraph 3"
  },
  "optionsAboutInspirationP4": {
    "message": "等我覺著找的差不多了，就把存在瀏覽器中的資料，匯出/貼上到 Gemini/豆包/DeepSeek 等 AI 工具，讓它們給我對比。",
    "description": "About inspiration paragraph 4"
  },
  "optionsAboutInspirationP5": {
    "message": "現在看來，這個工具的模式：自訂抽取規則、用 AI 解析網頁、儲存、彙總、對比，適用於符合這個模式的各種場景，比如：商品的對比、招聘資訊抽取和對比。",
    "description": "About inspiration paragraph 5"
  },
  "optionsAboutHowHeading": {
    "message": "怎麼用",
    "description": "About section: how to use"
  },
  "optionsAboutHowStep1": {
    "message": "開啟「$SETTINGS$ → $MODEL$」，填一個外部模型（DeepSeek / OpenAI / 通義 / Claude 等），或載入瀏覽器內建 Gemini Nano。",
    "description": "About how-to step 1",
    "placeholders": {
      "SETTINGS": { "content": "$1" },
      "MODEL": { "content": "$2" }
    }
  },
  "optionsAboutHowStep2": {
    "message": "正常瀏覽網站，遇到想要抽取資料的網頁，就點工具列圖示開啟側欄。",
    "description": "About how-to step 2"
  },
  "optionsAboutHowStep3": {
    "message": "點「$ACTION$」，把網頁讀取到側欄對話框，可以輸入 / 選一條 Skill，也可以口頭規定要讀取的內容。",
    "description": "About how-to step 3",
    "placeholders": {
      "ACTION": { "content": "$1" }
    }
  },
  "optionsAboutHowStep3Note": {
    "message": "需要注意的是，不同模型的上下文大小不同，有些可能不足以支撐你要解析的網頁。為了盡可能減少因為上下文不夠大導致的錯誤，我已經對網頁進行了裁剪，但是不能保證適配所有模型。所以，當發生錯誤的時候，切換一個更厲害的模型，是一個好的解決辦法。",
    "description": "About how-to step 3 context-size note"
  },
  "optionsAboutHowStep3SkillLimit": {
    "message": "為了簡化功能，每次對話只能選擇一個 Skill。",
    "description": "About how-to: single skill per turn"
  },
  "optionsAboutHowStep4": {
    "message": "模型回傳解析結果後點氣泡上的「$STORE$」。到左側「$DATA$」裡檢視、編輯；需要再問模型時，可把紀錄「$EXPORT$」。",
    "description": "About how-to step 4",
    "placeholders": {
      "STORE": { "content": "$1" },
      "DATA": { "content": "$2" },
      "EXPORT": { "content": "$3" }
    }
  },
  "optionsAboutSendModeHeading": {
    "message": "傳送方式",
    "description": "About section: send modes"
  },
  "optionsAboutSendModeIntro": {
    "message": "為了方便使用，我預置了四種對話方式，傳送鍵左側可切換。",
    "description": "About send mode intro"
  },
  "optionsAboutSendModeChat": {
    "message": "$LABEL$：走模型，可帶會話歷史。適合問答。",
    "description": "About send mode: chat",
    "placeholders": {
      "LABEL": { "content": "$1" }
    }
  },
  "optionsAboutSendModeDirect": {
    "message": "$LABEL$：不呼叫模型，立刻寫入本地。適合自己快速儲存資料。",
    "description": "About send mode: direct store",
    "placeholders": {
      "LABEL": { "content": "$1" }
    }
  },
  "optionsAboutSendModeAsync": {
    "message": "$LABEL$：可以解析多個網頁，同時最多處理 5 個。",
    "description": "About send mode: async parse",
    "placeholders": {
      "LABEL": { "content": "$1" }
    }
  },
  "optionsAboutSendModeOneClick": {
    "message": "$LABEL$：保持網頁解析設定，自動儲存解析結果，方便連續解析多個網頁。",
    "description": "About send mode: one-click collect",
    "placeholders": {
      "LABEL": { "content": "$1" }
    }
  },
  "optionsAboutSendModeHint": {
    "message": "你可以在設定中，透過組合對話條件，建立自己的對話方式。",
    "description": "About send mode custom hint"
  },
  "optionsAboutPrivacyHeading": {
    "message": "資料與隱私",
    "description": "About section: privacy"
  },
  "optionsAboutPrivacyP1": {
    "message": "採集結果預設只在本機瀏覽器（IndexedDB）。",
    "description": "About privacy paragraph 1"
  },
  "optionsAboutPrivacyP2": {
    "message": "發給模型的內容，會發到你在設定裡填寫的供應商。",
    "description": "About privacy paragraph 2"
  },
  "optionsAboutPrivacyP3": {
    "message": "系統頁、擴充功能商店等受保護頁面讀不了。",
    "description": "About privacy paragraph 3"
  },
  "optionsAboutPrivacyP4": {
