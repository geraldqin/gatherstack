  "optionsAboutProductName": {
    "message": "GatherStack",
    "description": "About: product name line"
  },
  "optionsAboutCoreHeading": {
    "message": "What it does",
    "description": "About section: core usage"
  },
  "optionsAboutDescription": {
    "message": "Use AI to parse web pages, store the results locally, and make later summarization and comparison easier.",
    "description": "About: core usage lead"
  },
  "optionsAboutWhatExtra": {
    "message": "Best for: collecting and processing information across many pages.",
    "description": "About: typical uses"
  },
  "optionsAboutInspirationHeading": {
    "message": "Where it came from",
    "description": "About section: inspiration"
  },
  "optionsAboutInspirationP1": {
    "message": "While apartment hunting, I had to manually note locations, rent, and other details, then gather them for comparison.",
    "description": "About inspiration paragraph 1"
  },
  "optionsAboutInspirationP2": {
    "message": "With large language models available, I wanted to simplify that workflow.",
    "description": "About inspiration paragraph 2"
  },
  "optionsAboutInspirationP3": {
    "message": "The idea: browse rental sites, and when one looks promising, ask a model to extract the fields I care about using rules I set up ahead of time (I call them Skills), then save the result in the browser.",
    "description": "About inspiration paragraph 3"
  },
  "optionsAboutInspirationP4": {
    "message": "Once I've saved a solid set, I export or paste the stored data into Gemini, Doubao, DeepSeek, or similar tools and let them compare for me.",
    "description": "About inspiration paragraph 4"
  },
  "optionsAboutInspirationP5": {
    "message": "That pattern—custom extract rules, AI page parsing, local storage, then summarize and compare—also fits product comparisons, job listings, and similar cross-page tasks.",
    "description": "About inspiration paragraph 5"
  },
  "optionsAboutHowHeading": {
    "message": "How to use",
    "description": "About section: how to use"
  },
  "optionsAboutHowStep1": {
    "message": "Open “$SETTINGS$ → $MODEL$”, add an external model (DeepSeek, OpenAI, DashScope, Claude, …), or load Chrome’s on-device Gemini Nano.",
    "description": "About how-to step 1",
    "placeholders": {
      "SETTINGS": { "content": "$1" },
      "MODEL": { "content": "$2" }
    }
  },
  "optionsAboutHowStep2": {
    "message": "Browse as usual; when you find a page you want to extract from, click the toolbar icon to open the side panel.",
    "description": "About how-to step 2"
  },
  "optionsAboutHowStep3": {
    "message": "Click “$ACTION$” to load the page into the side-panel chat. You can type / to pick a Skill, or just say what you want to extract.",
    "description": "About how-to step 3",
    "placeholders": {
      "ACTION": { "content": "$1" }
    }
  },
  "optionsAboutHowStep3Note": {
    "message": "Models have different context limits; some may be too small for the page you want to extract from. Pages are trimmed to reduce context overflow, but that cannot cover every model. If something fails, switching to a stronger model is often a good fix.",
    "description": "About how-to step 3 context-size note"
  },
  "optionsAboutHowStep3SkillLimit": {
    "message": "To keep things simple, each chat turn can only use one Skill.",
    "description": "About how-to: single skill per turn"
  },
  "optionsAboutHowStep4": {
    "message": "After the model returns a result, click “$STORE$” on the bubble. Review and edit under “$DATA$” on the left. To ask the model again, “$EXPORT$” the record.",
    "description": "About how-to step 4",
    "placeholders": {
      "STORE": { "content": "$1" },
      "DATA": { "content": "$2" },
      "EXPORT": { "content": "$3" }
    }
  },
  "optionsAboutSendModeHeading": {
    "message": "Send modes",
    "description": "About section: send modes"
  },
  "optionsAboutSendModeIntro": {
    "message": "Four built-in send modes are available; switch them to the left of Send.",
    "description": "About send mode intro"
  },
  "optionsAboutSendModeChat": {
    "message": "$LABEL$: calls the model and can include chat history. Best for Q&A.",
    "description": "About send mode: chat",
    "placeholders": {
      "LABEL": { "content": "$1" }
    }
  },
  "optionsAboutSendModeDirect": {
    "message": "$LABEL$: skips the model and writes locally right away. Best for quick manual saves.",
    "description": "About send mode: direct store",
    "placeholders": {
      "LABEL": { "content": "$1" }
    }
  },
  "optionsAboutSendModeAsync": {
    "message": "$LABEL$: run multiple page parses in parallel—no need to wait for the previous reply. Up to 5 at a time by default.",
    "description": "About send mode: async parse",
    "placeholders": {
      "LABEL": { "content": "$1" }
    }
  },
  "optionsAboutSendModeOneClick": {
    "message": "$LABEL$: keep your page-parse setup and auto-save results—handy for parsing multiple pages continuously.",
    "description": "About send mode: one-click collect",
    "placeholders": {
      "LABEL": { "content": "$1" }
    }
  },
  "optionsAboutSendModeHint": {
    "message": "In Settings, combine chat conditions to create your own send modes.",
    "description": "About send mode custom hint"
  },
  "optionsAboutPrivacyHeading": {
    "message": "Data and privacy",
    "description": "About section: privacy"
  },
  "optionsAboutPrivacyP1": {
    "message": "Collected records stay in this browser by default (IndexedDB).",
    "description": "About privacy paragraph 1"
  },
  "optionsAboutPrivacyP2": {
    "message": "Anything sent to a model goes to the provider you configured in Settings.",
    "description": "About privacy paragraph 2"
  },
  "optionsAboutPrivacyP3": {
    "message": "System pages and the Chrome Web Store cannot be read.",
    "description": "About privacy paragraph 3"
  },
  "optionsAboutPrivacyP4": {
    "message": "Clearing this extension’s site data deletes the local store.",
    "description": "About privacy paragraph 4"
  },
  "optionsAboutPricingHeading": {
    "message": "Pricing",
    "description": "About section: pricing"
  },
  "optionsAboutPricingP1": {
    "message": "Everything is free for now. The extension runs locally in your browser, so there are no server costs.",
    "description": "About pricing paragraph 1"
  },
  "optionsAboutPricingP2": {
    "message": "Whether paid features show up later depends on how people actually use it. One thing is fixed: if anything becomes paid, it will only be new capabilities; what you can use today stays free.",
    "description": "About pricing paragraph 2"
  },
